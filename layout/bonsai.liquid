<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {% render 'favicon' %}
    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {%- if template.suffix == 'wishlist' -%}
      <meta name="robots" content="noindex">
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {{ 'bonsai-theme.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'product' -%}
      {%- comment -%} Hold the first paint until the main photo exists, so it can be the end of the card-to-page morph {%- endcomment -%}
      <link rel="expect" href="#bh-pdp-stage" blocking="render">
    {%- endif -%}
    {% render 'bonsai-view-transitions' %}
    {% render 'bonsai-wishlist-store' %}
    {{ content_for_header }}
  </head>
  <body class="bh-body">
    {% sections 'header-group' %}
    {{ content_for_layout }}
    {% sections 'footer-group' %}
    <script src="{{ 'standard-actions-override.js' | asset_url }}" defer></script>
    <script>
      window.bhDeliveryConfig = {
        regions: [
          { states: {{ settings.delivery_home_states | json }}, min: {{ settings.delivery_home_min | json }}, max: {{ settings.delivery_home_max | json }} },
          { states: {{ settings.delivery_nearby_states | json }}, min: {{ settings.delivery_nearby_min | json }}, max: {{ settings.delivery_nearby_max | json }} },
          { states: {{ settings.delivery_paid_states | json }}, min: {{ settings.delivery_paid_min | json }}, max: {{ settings.delivery_paid_max | json }}, paid: true }
        ],
        rest: { min: {{ settings.delivery_rest_min | json }}, max: {{ settings.delivery_rest_max | json }} },
        skipSundays: {{ settings.delivery_skip_sundays | json }},
        cutoffHour: {{ settings.delivery_cutoff_hour | json }}
      };
    </script>
    <script src="{{ 'bonsai-theme.js' | asset_url }}" defer></script>
  </body>
</html>
