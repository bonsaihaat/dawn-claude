{{ 'bonsai-404.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' '
  assign wa_url = 'https://wa.me/' | append: wa_number
  assign popular = section.settings.popular_searches | split: ','

  comment
    Category tiles are the sub-items of one main-menu item (the main categories),
    followed by one extra collection.
  endcomment
  assign cat_links = blank
  for link in linklists[section.settings.menu].links
    if link.title == section.settings.menu_item
      assign cat_links = link.links
      break
    endif
  endfor
  assign extra = section.settings.extra_collection
  assign favourites = section.settings.products_collection | default: collections['bestselling-bonsai-plants']
-%}

<div class="bh bh-nf">
  <div class="bh-nf__wrap">

    <div class="bh-nf__msg">
      <span class="bh-nf__eyebrow">{{ section.settings.eyebrow }}</span>
      <svg class="bh-nf__illo" viewBox="0 0 120 120" fill="none" aria-hidden="true">
        <ellipse cx="60" cy="100" rx="30" ry="6" fill="#e7e2d3"/>
        <path d="M34 58h52l-6 38a6 6 0 0 1-6 5H46a6 6 0 0 1-6-5l-6-38Z" fill="#eef4e0" stroke="#2E4716" stroke-width="2.5"/>
        <path d="M30 58h60l-3 10H33l-3-10Z" fill="#dce8c4" stroke="#2E4716" stroke-width="2.5" stroke-linejoin="round"/>
        <path d="M60 58c-2-10 2-18 10-22" stroke="#9aa093" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="1 5"/>
        <path d="M78 30c4 6 2 14-6 18-4-8-2-15 6-18Z" fill="#5F8F2B" transform="rotate(28 75 38)"/>
      </svg>
      <h1 class="bh-nf__title">{{ section.settings.heading }}</h1>
      <p class="bh-nf__text">{{ section.settings.text }}</p>
      <div class="bh-nf__actions">
        <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="bh-nf__primary">{{ section.settings.primary_label }}</a>
        <a href="{{ routes.root_url }}" class="bh-nf__secondary">{{ section.settings.secondary_label }}</a>
      </div>
    </div>

    <div class="bh-nf__search">
      <form action="{{ routes.search_url }}" method="get" class="bh-nf__form" role="search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="#767d6c" stroke-width="1.8"/><line x1="21" y1="21" x2="16.5" y2="16.5" stroke="#767d6c" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input type="search" name="q" class="bh-nf__input" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="Search">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="bh-nf__submit">{{ section.settings.search_button }}</button>
      </form>
      {%- if section.settings.popular_searches != blank -%}
        <div class="bh-nf__chips">
          {%- for term in popular -%}
            {%- assign label = term | strip -%}
            {%- if label != blank -%}
              <a href="{{ routes.search_url }}?q={{ label | url_encode }}&amp;type=product&amp;options%5Bprefix%5D=last">{{ label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if cat_links != blank or extra != blank -%}
      <div class="bh-nf__block">
        <h2 class="bh-nf__h2">{{ section.settings.categories_heading }}</h2>
        <div class="bh-nf__cats">
          {%- for link in cat_links -%}
            <a href="{{ link.url }}" class="bh-nf__cat">
              {%- if link.type == 'collection_link' and link.object.featured_image != blank -%}
                {{ link.object.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 400, 600', sizes: '(min-width: 820px) 190px, 45vw', alt: link.title }}
              {%- endif -%}
              <div class="bh-nf__cat-shade"></div>
              <span class="bh-nf__cat-label">{{ link.title }}</span>
            </a>
          {%- endfor -%}
          {%- if extra != blank -%}
            <a href="{{ extra.url }}" class="bh-nf__cat">
              {%- if extra.featured_image != blank -%}
                {{ extra.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 400, 600', sizes: '(min-width: 820px) 190px, 45vw', alt: extra.title }}
              {%- endif -%}
              <div class="bh-nf__cat-shade"></div>
              <span class="bh-nf__cat-label">{{ extra.title }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if favourites != blank and favourites.products.size > 0 -%}
      <div class="bh-nf__block">
        <h2 class="bh-nf__h2">{{ section.settings.products_heading }}</h2>
        <div class="bh-nf__products">
          {%- for product in favourites.products limit: 4 -%}
            {%- capture product_price -%}{%- render 'bonsai-money', amount: product.price -%}{%- endcapture -%}
            {%- render 'bonsai-product-card',
              url: product.url,
              image: product.featured_media,
              title: product.title,
              subtitle: product.metafields.custom.subtitle,
              price: product_price,
              badge: product.metafields.custom.badge
            -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_help -%}
      <div class="bh-nf__help">
        <span class="bh-nf__help-title">{{ section.settings.help_heading }}</span>
        <div class="bh-nf__help-actions">
          {%- if wa_number != blank -%}
            <a href="{{ wa_url }}" target="_blank" rel="noopener" class="bh-nf__help-wa">{{ section.settings.whatsapp_label }}</a>
          {%- endif -%}
          <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="bh-nf__help-contact">{{ section.settings.contact_label }}</a>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Bonsai 404",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Error 404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has been pruned" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The page you're looking for may have moved — our store has a new home. Let's help you find your bonsai." },
    { "type": "text", "id": "primary_label", "label": "Button label", "default": "Shop all bonsai" },
    { "type": "url", "id": "primary_link", "label": "Button link", "info": "Defaults to all products." },
    { "type": "text", "id": "secondary_label", "label": "Homepage link label", "default": "Go to homepage" },
    { "type": "header", "content": "Search" },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder", "default": "Search bonsai, pots, tools…" },
    { "type": "text", "id": "search_button", "label": "Button label", "default": "Search" },
    { "type": "text", "id": "popular_searches", "label": "Popular searches", "default": "Ficus,Jade,Juniper,Indoor bonsai,Ceramic pots,Bonsai tools", "info": "Comma-separated. Each opens a product search." },
    { "type": "header", "content": "Categories" },
    { "type": "text", "id": "categories_heading", "label": "Heading", "default": "Browse categories" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "menu_item", "label": "Menu item", "default": "Bonsai Plants", "info": "Its sub-items become the tiles, with their collection images." },
    { "type": "collection", "id": "extra_collection", "label": "Extra tile", "info": "One more collection shown after the menu tiles, e.g. Pots & Accessories." },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_heading", "label": "Heading", "default": "Customer favourites" },
    { "type": "collection", "id": "products_collection", "label": "Collection", "info": "Shows its first 4 products. Defaults to the collection with handle \"bestselling-bonsai-plants\"." },
    { "type": "header", "content": "Help strip" },
    { "type": "checkbox", "id": "show_help", "label": "Show help strip", "default": true },
    { "type": "text", "id": "help_heading", "label": "Heading", "default": "Can't find what you were looking for?" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button label", "default": "Chat on WhatsApp", "info": "Uses the WhatsApp number in Theme settings → Contact." },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Contact us" },
    { "type": "url", "id": "contact_link", "label": "Contact button link", "info": "Defaults to /pages/contact." }
  ],
  "presets": [ { "name": "Bonsai 404" } ]
}
{% endschema %}
