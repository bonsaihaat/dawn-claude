<script>
  // Cancellation and return requests need an order number.
  (function () {
    var form = document.getElementById('BhContactForm');
    if (!form) return;
    var topic = form.querySelector('[data-bh-contact-topic]');
    var input = form.querySelector('[data-bh-contact-order-input]');
    var mark = form.querySelector('[data-bh-contact-order-mark]');
    function sync() {
      var needed = /cancel|return/i.test(topic.value);
      input.required = needed;
      mark.hidden = !needed;
    }
    topic.addEventListener('change', sync);
    sync();

    // Phone: the digit count must suit the chosen country (10 for India), using
    // each country's mobile and landline lengths from Google's libphonenumber.
    // A typed country code or leading 0 is ignored; spaces and dashes are fine.
    var country = form.querySelector('[data-bh-contact-country]');
    var number = form.querySelector('[data-bh-contact-number]');
    function plan() {
      var opt = country.options[country.selectedIndex];
      return {
        code: opt.getAttribute('data-code'),
        lengths: opt.getAttribute('data-lengths').split(',').map(Number),
        name: opt.text.replace(/^\S+ \+\d+ /, '')
      };
    }
    function nationalDigits(p) {
      var digits = number.value.replace(/\D/g, '');
      var fits = function (d) { return p.lengths.indexOf(d.length) !== -1; };
      if (!fits(digits) && digits.indexOf(p.code) === 0 && fits(digits.slice(p.code.length))) digits = digits.slice(p.code.length);
      if (!fits(digits) && digits.charAt(0) === '0' && fits(digits.slice(1))) digits = digits.slice(1);
      return digits;
    }
    function lengthText(l) {
      if (l.length === 1) return String(l[0]);
      if (l.length === 2) return l[0] + ' or ' + l[1];
      var run = l[l.length - 1] - l[0] === l.length - 1;
      return run ? l[0] + '–' + l[l.length - 1] : l.slice(0, -1).join(', ') + ' or ' + l[l.length - 1];
    }
    function checkPhone() {
      var p = plan();
      var digits = nationalDigits(p);
      var ok = !digits || p.lengths.indexOf(digits.length) !== -1;
      number.setCustomValidity(ok ? '' : 'Please enter a valid phone number for ' + p.name + ' (' + lengthText(p.lengths) + ' digits).');
      number.placeholder = lengthText(p.lengths) + ' digits';
    }
    // Searchable country picker: a button showing the flag and code opens a
    // list filtered by country name, calling code or common short names. It
    // drives the hidden native select, which still works without JavaScript.
    (function () {
      var wrap = form.querySelector('[data-bh-contact-phone]');
      var ALIASES = {
        AE: 'uae emirates dubai abu dhabi', US: 'usa america', GB: 'uk britain england scotland wales',
        SA: 'ksa', KR: 'korea', KP: 'korea', RU: 'russia', NL: 'holland', CZ: 'czech',
        CN: 'prc', LK: 'ceylon', MM: 'burma', CI: 'ivory coast', ZA: 'rsa'
      };
      var norm = function (t) { return String(t).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); };
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'bh-contact__cc';
      btn.setAttribute('aria-haspopup', 'listbox');
      btn.setAttribute('aria-expanded', 'false');
      var panel = document.createElement('div');
      panel.className = 'bh-contact__cc-panel';
      panel.hidden = true;
      var search = document.createElement('input');
      search.type = 'search';
      search.className = 'bh-contact__cc-search';
      search.placeholder = 'Search country or code';
      search.autocomplete = 'off';
      search.setAttribute('aria-label', 'Search country or calling code');
      search.setAttribute('role', 'combobox');
      search.setAttribute('aria-controls', 'BhContactCountryList');
      search.setAttribute('aria-autocomplete', 'list');
      search.setAttribute('aria-expanded', 'true');
      var list = document.createElement('ul');
      list.id = 'BhContactCountryList';
      list.className = 'bh-contact__cc-list';
      list.setAttribute('role', 'listbox');
      var empty = document.createElement('li');
      empty.className = 'bh-contact__cc-empty';
      empty.textContent = 'No country found';
      empty.hidden = true;
      var items = Array.prototype.map.call(country.options, function (opt, i) {
        var parts = opt.text.match(/^(\S+) \+(\d+) (.*)$/);
        var li = document.createElement('li');
        li.id = 'BhContactCountry-' + i;
        li.setAttribute('role', 'option');
        ['flag', 'name', 'code'].forEach(function (k) {
          var span = document.createElement('span');
          span.className = 'bh-contact__cc-' + k;
          li.appendChild(span);
        });
        li.children[0].textContent = parts[1];
        li.children[1].textContent = parts[3];
        li.children[2].textContent = '+' + parts[2];
        var iso = opt.getAttribute('data-iso') || '';
        li.bhSearch = norm(parts[3] + ' ' + iso + ' ' + (ALIASES[iso] || ''));
        li.bhCode = parts[2];
        li.bhIndex = i;
        // Keep focus in the search box while choosing.
        li.addEventListener('mousedown', function (e) { e.preventDefault(); });
        li.addEventListener('click', function () { choose(i); });
        list.appendChild(li);
        return li;
      });
      list.appendChild(empty);
      panel.appendChild(search);
      panel.appendChild(list);
      wrap.insertBefore(btn, country);
      wrap.appendChild(panel);
      country.classList.add('bh-contact__cc-native');
      country.tabIndex = -1;
      country.setAttribute('aria-hidden', 'true');

      var active = -1;
      function shown() { return items.filter(function (li) { return !li.hidden; }); }
      function setActive(li) {
        items.forEach(function (x) { x.classList.toggle('is-active', x === li); });
        active = li ? li.bhIndex : -1;
        if (li) {
          search.setAttribute('aria-activedescendant', li.id);
          li.scrollIntoView({ block: 'nearest' });
        } else {
          search.removeAttribute('aria-activedescendant');
        }
      }
      function filter() {
        var q = norm(search.value).trim();
        var byCode = /^\+?\s*\d+$/.test(q);
        var digits = q.replace(/\D/g, '');
        items.forEach(function (li) {
          li.hidden = q !== '' && (byCode ? li.bhCode.indexOf(digits) !== 0 : li.bhSearch.indexOf(q) === -1);
        });
        var visible = shown();
        empty.hidden = visible.length > 0;
        setActive(visible[0] || null);
      }
      function updateButton() {
        var li = items[country.selectedIndex];
        btn.textContent = li.children[0].textContent + ' +' + li.bhCode;
        btn.setAttribute('aria-label', 'Country code: ' + li.children[1].textContent + ' +' + li.bhCode + '. Change');
        items.forEach(function (x) { x.setAttribute('aria-selected', String(x.bhIndex === country.selectedIndex)); });
      }
      function open() {
        panel.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        search.value = '';
        filter();
        setActive(items[country.selectedIndex]);
        search.focus();
      }
      function close(focusButton) {
        if (panel.hidden) return;
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
        if (focusButton) btn.focus();
      }
      function choose(i) {
        country.selectedIndex = i;
        country.dispatchEvent(new Event('change'));
        updateButton();
        close(false);
        number.focus();
      }
      btn.addEventListener('click', function () { if (panel.hidden) open(); else close(true); });
      search.addEventListener('input', filter);
      search.addEventListener('keydown', function (e) {
        var visible = shown();
        var pos = visible.indexOf(items[active]);
        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(visible[Math.min(pos + 1, visible.length - 1)] || null); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(visible[Math.max(pos - 1, 0)] || null); }
        else if (e.key === 'Enter') { e.preventDefault(); if (active !== -1) choose(active); }
        else if (e.key === 'Escape') { e.preventDefault(); close(true); }
        else if (e.key === 'Tab') close(false);
      });
      document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(false); });
      updateButton();
    })();

    number.addEventListener('input', checkPhone);
    country.addEventListener('change', checkPhone);
    // Send just the national digits, e.g. 9340957839, next to the country code.
    form.addEventListener('submit', function () {
      var digits = nationalDigits(plan());
      if (digits) number.value = digits;
    });
    checkPhone();
  })();
</script>

