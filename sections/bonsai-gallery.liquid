{{ 'bonsai-gallery.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Gallery page (template page.gallery) with Photos and Videos tabs. Entries come
  from Shopify admin → Content → Metaobjects → Gallery photo / Gallery video,
  newest first (entry IDs only grow, so the highest ID is the latest added);
  tapping one opens it full size, videos playing from YouTube. The tabs only show when
  both have entries, and #videos in the address opens the Videos tab. The
  theme editor's Photo blocks are only a fallback while no photo entries are
  shown. The page's own content (Online Store → Pages) shows as the intro.
{%- endcomment -%}
{%- liquid
  assign photo_entries = shop.metaobjects.gallery_photo.values
  assign photo_keys = ''
  for entry in photo_entries
    if entry.show_in_gallery.value == false or entry.image.value == blank
      continue
    endif
    # Padding keeps every ID the same length so text sorting matches number order.
    assign sort_id = entry.system.id | plus: 1000000000000000
    assign sort_index = forloop.index0 | plus: 10000
    assign photo_keys = photo_keys | append: sort_id | append: '-' | append: sort_index | append: ','
  endfor
  assign photo_keys = photo_keys | split: ',' | sort | reverse
  assign photo_blocks = section.blocks | where: 'type', 'photo'

  assign video_entries = shop.metaobjects.gallery_video.values
  assign video_keys = ''
  for entry in video_entries
    if entry.show_in_gallery.value == false or entry.youtube_url.value == blank
      continue
    endif
    # Padding keeps every ID the same length so text sorting matches number order.
    assign sort_id = entry.system.id | plus: 1000000000000000
    assign sort_index = forloop.index0 | plus: 10000
    assign video_keys = video_keys | append: sort_id | append: '-' | append: sort_index | append: ','
  endfor
  assign video_keys = video_keys | split: ',' | sort | reverse
-%}

{%- capture photo_items -%}
  {%- if photo_keys.size > 0 -%}
    {%- for key in photo_keys -%}
      {%- assign entry_index = key | split: '-' | last | minus: 10000 -%}
      {%- for entry in photo_entries -%}
        {%- if forloop.index0 == entry_index -%}
          {%- render 'bonsai-gallery-photo', image: entry.image.value, caption: entry.caption.value -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- else -%}
    {%- for block in photo_blocks -%}
      {%- render 'bonsai-gallery-photo', image: block.settings.image, caption: block.settings.caption, attributes: block.shopify_attributes -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture video_items -%}
  {%- for key in video_keys -%}
    {%- assign entry_index = key | split: '-' | last | minus: 10000 -%}
    {%- for entry in video_entries -%}
      {%- if forloop.index0 == entry_index -%}
        {%- render 'bonsai-gallery-video', url: entry.youtube_url.value, title: entry.title.value -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign has_photos = false -%}
{%- if photo_items contains 'data-bh-gallery-item' -%}{%- assign has_photos = true -%}{%- endif -%}
{%- assign has_videos = false -%}
{%- if video_items contains 'data-bh-gallery-item' -%}{%- assign has_videos = true -%}{%- endif -%}

<div class="bh bh-gallery" data-bh-gallery>
  <div class="bh-gallery__wrap">
    <nav class="bh-gallery__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span class="bh-gallery__crumb-current">{{ page.title | default: 'Gallery' }}</span>
    </nav>

    <h1 class="bh-gallery__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if page.content != blank -%}
      <div class="bh-gallery__intro">{{ page.content }}</div>
    {%- endif -%}

    {%- if has_photos and has_videos -%}
      <div class="bh-gallery__tabs" role="tablist" aria-label="Gallery">
        <button type="button" role="tab" id="bh-gallery-tab-photos" aria-controls="bh-gallery-photos" aria-selected="true" data-bh-gallery-tab="photos">Photos</button>
        <button type="button" role="tab" id="bh-gallery-tab-videos" aria-controls="bh-gallery-videos" aria-selected="false" tabindex="-1" data-bh-gallery-tab="videos">Videos</button>
      </div>
    {%- endif -%}

    {%- if has_photos -%}
      <div class="bh-gallery__grid" id="bh-gallery-photos" data-bh-gallery-panel="photos"{% if has_videos %} role="tabpanel" aria-labelledby="bh-gallery-tab-photos"{% endif %}>{{ photo_items }}</div>
    {%- endif -%}
    {%- if has_videos -%}
      <div class="bh-gallery__videos" id="bh-gallery-videos" data-bh-gallery-panel="videos"{% if has_photos %} role="tabpanel" aria-labelledby="bh-gallery-tab-videos" hidden{% endif %}>{{ video_items }}</div>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="bh-gallery__cta">
        <p>{{ section.settings.cta_text }}</p>
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="bh-btn bh-btn--dark">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>

  <dialog class="bh-gallery__dialog" data-bh-gallery-dialog aria-label="Gallery viewer">
    <button type="button" class="bh-gallery__nav bh-gallery__nav--prev" data-bh-gallery-step="-1" aria-label="Previous">‹</button>
    <img alt="" data-bh-gallery-img>
    <div class="bh-gallery__player" data-bh-gallery-player hidden></div>
    <button type="button" class="bh-gallery__nav bh-gallery__nav--next" data-bh-gallery-step="1" aria-label="Next">›</button>
    <button type="button" class="bh-gallery__close" data-bh-gallery-close aria-label="Close">×</button>
  </dialog>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    var dialog = root.querySelector('[data-bh-gallery-dialog]');
    var img = root.querySelector('[data-bh-gallery-img]');
    var player = root.querySelector('[data-bh-gallery-player]');
    var steps = root.querySelectorAll('[data-bh-gallery-step]');

    // Tabs: Photos / Videos, remembered in the address as #videos.
    var tabs = root.querySelectorAll('[data-bh-gallery-tab]');
    function setTab(name) {
      tabs.forEach(function (t) {
        var on = t.getAttribute('data-bh-gallery-tab') === name;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      root.querySelectorAll('[data-bh-gallery-panel]').forEach(function (p) {
        p.hidden = p.getAttribute('data-bh-gallery-panel') !== name;
      });
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var name = t.getAttribute('data-bh-gallery-tab');
        setTab(name);
        history.replaceState(null, '', name === 'videos' ? '#videos' : window.location.pathname + window.location.search);
      });
      t.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        var other = root.querySelector('[data-bh-gallery-tab]:not([aria-selected="true"])');
        if (other) { other.click(); other.focus(); }
      });
    });
    if (tabs.length && window.location.hash === '#videos') setTab('videos');

    // Viewer: photos full size, videos as a YouTube player that stops on close.
    if (!dialog || !dialog.showModal) return;
    var items = [];
    var current = 0;
    function show(i) {
      current = (i + items.length) % items.length;
      var el = items[current];
      var video = el.getAttribute('data-video');
      player.innerHTML = '';
      img.hidden = !!video;
      player.hidden = !video;
      if (video) {
        img.removeAttribute('src');
        player.classList.toggle('is-short', el.hasAttribute('data-short'));
        var frame = document.createElement('iframe');
        frame.src = 'https://www.youtube-nocookie.com/embed/' + video + '?autoplay=1&rel=0&playsinline=1';
        frame.title = el.getAttribute('data-alt') || 'YouTube video';
        frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        frame.allowFullscreen = true;
        player.appendChild(frame);
      } else {
        img.src = el.getAttribute('data-src');
        img.alt = el.getAttribute('data-alt');
      }
      steps.forEach(function (b) { b.hidden = items.length < 2; });
    }
    root.addEventListener('click', function (e) {
      var el = e.target.closest('[data-bh-gallery-item]');
      if (!el || !root.contains(el)) return;
      var panel = el.closest('[data-bh-gallery-panel]');
      items = Array.prototype.slice.call(panel.querySelectorAll('[data-bh-gallery-item]'));
      show(items.indexOf(el));
      dialog.showModal();
    });
    steps.forEach(function (b) {
      b.addEventListener('click', function () { show(current + Number(b.getAttribute('data-bh-gallery-step'))); });
    });
    // Removing the player stops the video; Esc closes without our handlers.
    function closeViewer() { player.innerHTML = ''; dialog.close(); }
    root.querySelector('[data-bh-gallery-close]').addEventListener('click', closeViewer);
    dialog.addEventListener('close', function () { player.innerHTML = ''; });
    // A click on the backdrop (outside the photo, video and buttons) closes it.
    dialog.addEventListener('click', function (e) { if (e.target === dialog) closeViewer(); });
    dialog.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  })();
</script>

{% schema %}
{
  "name": "Gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_text", "label": "Text", "default": "Every tree in our shop is photographed exactly as it ships." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop bonsai" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo (fallback)",
      "settings": [
        { "type": "paragraph", "content": "Only used while Content → Metaobjects → Gallery photo has no entries." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Optional. Shown under the photo; the photo's alt text is used for screen readers when empty." }
      ]
    }
  ],
  "presets": [{ "name": "Gallery" }]
}
{% endschema %}
