{{ 'section-promo-ticker.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #PromoTicker-{{ section.id }} .promo-ticker__inner {
    --promo-ticker-duration: {{ section.settings.scroll_speed }}s;
  }
{%- endstyle -%}

{%- liquid
  assign ticker_messages = shop.metafields.custom.ticker_messages.value
  assign use_metafield = false
  if ticker_messages != blank and ticker_messages.size > 0
    assign use_metafield = true
  endif
-%}

{%- if use_metafield or section.blocks.size > 0 -%}
  <div
    id="PromoTicker-{{ section.id }}"
    class="promo-ticker color-{{ section.settings.color_scheme }} gradient"
    role="region"
    aria-label="Promotions"
  >
    <div class="promo-ticker__inner{% if section.settings.pause_on_hover %} promo-ticker__inner--pause-hover{% endif %}">
      {%- for copy in (1..2) -%}
        <div class="promo-ticker__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
          {%- if use_metafield -%}
            {%- for message in ticker_messages -%}
              {%- assign message_parts = message | split: '|' -%}
              {%- assign message_text = message_parts[0] | strip -%}
              {%- assign message_link = '' -%}
              {%- if message_parts.size > 1 -%}
                {%- assign message_link = message_parts[1] | strip -%}
              {%- endif -%}
              <div class="promo-ticker__item">
                {%- if message_link != blank -%}
                  <a href="{{ message_link | escape }}"{% if copy == 2 %} tabindex="-1"{% endif %}>
                {%- endif -%}
                <span>{{ message_text | escape }}</span>
                {%- if message_link != blank -%}
                  </a>
                {%- endif -%}
                <span class="promo-ticker__sep" aria-hidden="true">{{ section.settings.separator }}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <div class="promo-ticker__item"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}"{% if copy == 2 %} tabindex="-1"{% endif %}>
                {%- endif -%}
                <span>{{ block.settings.text | escape }}</span>
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
                <span class="promo-ticker__sep" aria-hidden="true">{{ section.settings.separator }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div id="PromoTicker-{{ section.id }}" class="promo-ticker promo-ticker--empty color-{{ section.settings.color_scheme }} gradient">
    <p class="promo-ticker__placeholder">Add offers via Settings → Custom data → Shop → "Promo Ticker Messages", or add Message blocks below</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Promo ticker",
  "tag": "div",
  "class": "section",
  "max_blocks": 20,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Day-to-day offer text is edited in Settings → Custom data → Shop → \"Promo Ticker Messages\" — no need to open the theme editor for that. To make a message clickable, add \"| \" followed by the URL after the text, e.g. \"Free shipping on orders above ₹1999 | /pages/shipping\". The Message blocks below are a fallback used only if that field is empty, and support optional links via their own Link setting."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "info": "Lower is faster",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between messages",
      "info": "Leave blank for no separator character between messages."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Free shipping on orders above ₹1999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo ticker",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Free shipping on orders above ₹1999"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Use code BONSAI10 for 10% off your first order"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Pan-India delivery in 3–5 days"
          }
        }
      ]
    }
  ]
}
{% endschema %}