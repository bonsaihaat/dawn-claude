{{ 'section-promo-ticker.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #PromoTicker-{{ section.id }} .promo-ticker__inner {
    --promo-ticker-duration: {{ section.settings.scroll_speed }}s;
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div
    id="PromoTicker-{{ section.id }}"
    class="promo-ticker color-{{ section.settings.color_scheme }} gradient"
    role="region"
    aria-label="Promotions"
  >
    <div class="promo-ticker__inner{% if section.settings.pause_on_hover %} promo-ticker__inner--pause-hover{% endif %}">
      <div class="promo-ticker__group">
        {%- for block in section.blocks -%}
          <div class="promo-ticker__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">
            {%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
            <span class="promo-ticker__sep" aria-hidden="true">{{ section.settings.separator }}</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="promo-ticker__group" aria-hidden="true">
        {%- for block in section.blocks -%}
          <div class="promo-ticker__item">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" tabindex="-1">
            {%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
            <span class="promo-ticker__sep" aria-hidden="true">{{ section.settings.separator }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div id="PromoTicker-{{ section.id }}" class="promo-ticker promo-ticker--empty color-{{ section.settings.color_scheme }} gradient">
    <p class="promo-ticker__placeholder">Add message blocks below to show offers here</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Promo ticker",
  "tag": "div",
  "class": "section",
  "max_blocks": 20,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "info": "Lower is faster",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between messages",
      "default": "•"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Free shipping on orders above ₹1999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo ticker",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "🌿 Free shipping on orders above ₹1999"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "✨ Use code BONSAI10 for 10% off your first order"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "🚚 Pan-India delivery in 3–5 days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
