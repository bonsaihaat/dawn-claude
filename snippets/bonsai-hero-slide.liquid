{%- comment -%}
  Accepts: image, mobile_image (optional, shown below 820px), headline (optional), caption, url (optional),
  first (true for the first slide), attributes (optional)
  Without a headline the slide shows just the photo (and caption), with no top shade.
  Images may be image objects or media images (from a metaobject file field).
{%- endcomment -%}
{%- liquid
  if image.preview_image
    assign slide_image = image.preview_image
  else
    assign slide_image = image
  endif
  if mobile_image.preview_image
    assign slide_mobile = mobile_image.preview_image
  else
    assign slide_mobile = mobile_image
  endif
  if first
    assign slide_loading = 'eager'
  else
    assign slide_loading = 'lazy'
  endif
  assign words = headline | split: ' '
  assign slide_label = headline | default: caption | default: shop.name
-%}
<div class="bh-slide{% if first %} is-active{% endif %}{% if headline == blank %} bh-slide--no-title{% endif %}" style="--words: {{ words.size }}" data-bh-slide {{ attributes }}>
  {%- if slide_image != blank -%}
    {%- if slide_mobile != blank -%}
      <picture>
        <source
          media="(max-width: 819.98px)"
          srcset="{% for w in (1..4) %}{% assign mw = w | times: 400 | plus: 200 %}{{ slide_mobile | image_url: width: mw }} {{ mw }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
          sizes="calc(100vw - 40px)"
        >
    {%- endif -%}
    {{
      slide_image
      | image_url: width: 2400
      | image_tag:
        class: 'bh-slide__img',
        widths: '600, 900, 1200, 1600, 2000, 2400',
        sizes: '(min-width: 1180px) 1140px, calc(100vw - 40px)',
        loading: slide_loading,
        alt: slide_label
    }}
    {%- if slide_mobile != blank -%}
      </picture>
    {%- endif -%}
  {%- endif -%}
  <div class="bh-slide__shade"></div>
  {%- if headline != blank -%}
    <div class="bh-slide__top">
      <h1 class="bh-slide__title">
        {%- render 'bonsai-words', text: headline -%}
      </h1>
    </div>
  {%- endif -%}
  {%- if caption != blank -%}
    <div class="bh-slide__bottom">
      <span class="bh-slide__chip">{{ caption }}</span>
    </div>
  {%- endif -%}
  {%- if url != blank -%}
    <a href="{{ url }}" class="bh-slide__link" aria-label="{{ slide_label | escape }}"></a>
  {%- endif -%}
</div>
