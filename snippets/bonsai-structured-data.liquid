{%- comment -%}
  Structured data (JSON-LD) for Google.
  - Product pages: Product with one Offer per variant, plus BreadcrumbList.
  - Homepage: Organization (name, logo, contact, social profiles).
  Brand is the store name (The Bonsai Haat). No ratings: the store has no product reviews.
{%- endcomment -%}

{%- if request.page_type == 'product' and product -%}
  {%- liquid
    assign crumb_collection = collection
    if crumb_collection == blank
      for c in product.collections
        unless c.handle == 'all' or c.handle == 'frontpage'
          assign crumb_collection = c
          break
        endunless
      endfor
    endif
    assign product_url = shop.url | append: product.url
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ product_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ product_url | json }},
      {%- if product.description != blank %}
      "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
      {%- endif %}
      {%- if product.images.size > 0 %}
      "image": [
        {%- for image in product.images limit: 10 -%}
          {{ image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      {%- endif %}
      {%- if product.selected_or_first_available_variant.sku != blank %}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif %}
      {%- if product.metafields.custom.category.value != blank %}
      "category": {{ product.metafields.custom.category.value | json }},
      {%- endif %}
      "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "url": {{ shop.url | append: variant.url | json }},
            {%- if variant.sku != blank %}
            "sku": {{ variant.sku | json }},
            {%- endif %}
            {%- if product.variants.size > 1 %}
            "name": {{ variant.title | json }},
            {%- endif %}
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
            "itemCondition": "https://schema.org/NewCondition",
            "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        {%- if crumb_collection != blank %}
        { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ shop.url | append: crumb_collection.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ product_url | json }} }
        {%- else %}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ product_url | json }} }
        {%- endif %}
      ]
    }
  </script>
{%- elsif request.page_type == 'index' -%}
  {%- liquid
    assign social = settings.social_instagram_link | append: '|' | append: settings.social_facebook_link | append: '|' | append: settings.social_youtube_link | append: '|' | append: settings.social_linkedin_link | append: '|' | append: settings.social_twitter_link | append: '|' | append: settings.social_pinterest_link
    assign social_links = social | split: '|' | compact
    assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' '
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ shop.url | append: '/#organization' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {%- if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif %}
      {%- if wa_number != blank or shop.email != blank %}
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        {%- if wa_number != blank %}
        "telephone": {{ '+' | append: wa_number | json }},
        {%- endif %}
        {%- if shop.email != blank %}
        "email": {{ shop.email | json }},
        {%- endif %}
        "areaServed": "IN"
      },
      {%- endif %}
      "sameAs": [
        {%- assign first = true -%}
        {%- for link in social_links -%}
          {%- if link != blank -%}
            {%- unless first %},{% endunless -%}{{ link | json }}{%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
